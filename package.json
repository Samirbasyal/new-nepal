{
  "//": "========================================",
  "//_comment": "PROJECT CONFIGURATION - Janakalyan Samataa Yuwa Club",
  "//_comment2": "This file lists the project name, scripts and libraries (dependencies).",
  "//_comment3": "Run: npm install  ->  installs everything listed below.",
  "//_comment4": "========================================",
  "name": "janakalyan-samataa-yuwa-club",
  "version": "1.0.0",
  "private": true,
  "description": "Official website of Janakalyan Samataa Yuwa Club - public website, member panel and admin panel.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:demo": "node prisma/seed-demo.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:reset": "node scripts/admin-reset.mjs",
    "db:use:sqlite": "node scripts/use-database.mjs sqlite",
    "db:use:postgres": "node scripts/use-database.mjs postgres",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "jose": "6.2.12",
    "nepali-date-converter": "^3.4.0",
    "next": "15.5.27",
    "nodemailer": "^10.0.15",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
