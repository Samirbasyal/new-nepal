# ========================================
# GIT IGNORE FILE
# Files listed here are NOT uploaded to GitHub.
# Secrets (.env) and generated files stay on your computer only.
# ========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Local environment variables (NEVER commit these - they contain secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Next.js build output
.next/
out/
build/
dist/

# Database files (SQLite local databases)
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# Uploaded images saved locally during development
public/uploads/*
!public/uploads/.gitkeep

# Private documents that must NEVER reach GitHub:
# scanned loan agreements and anything else stored outside the website.
private/

# Test scripts and their output (tools/test-*.mjs run against your own machine)
tools/

# Logs
npm-debug.log*
yarn-debug.log*G
yarn-error.log*
*.log

# Editor / OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Vercel
.vercel

# TypeScript cache
*.tsbuildinfo
next-env.d.ts
*.before-the-fix
*.before-phase*
*.before-the-fix
*.before-phase*

node-compile-cache/
.vercel
.env*
