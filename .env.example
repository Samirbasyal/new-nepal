# ========================================
# ENVIRONMENT VARIABLES - EXAMPLE FILE
# ========================================
# This file is a SAFE TEMPLATE. It contains NO real secrets.
#
# HOW TO USE IT:
#   1. Copy this file and rename the copy to exactly:  .env
#   2. Fill in your own real values inside .env
#   3. NEVER upload the real .env file to GitHub (it is already blocked in .gitignore)
#
# On Vercel you do NOT create a file. Instead you add each variable
# in: Project -> Settings -> Environment Variables.
# ========================================


# ----------------------------------------
# 1. DATABASE
# ----------------------------------------
# The address of your PostgreSQL database.
#
# FREE OPTION (recommended for beginners) - Neon (https://neon.tech):
#   Create a project, then copy the "Connection string" it shows you.
# FREE OPTION - Supabase (https://supabase.com):
#   Project Settings -> Database -> Connection string -> URI
# FREE OPTION - Vercel Postgres (https://vercel.com/storage/postgres)
#
# It looks like this (replace the parts in < > with your real values):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
#
# WANT TO TRY THE WEBSITE WITHOUT ANY CLOUD DATABASE?
#   Run:  npm run db:use:sqlite
#   (that switches the project to a local file database and prints the next steps)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"


# ----------------------------------------
# 2. AUTHENTICATION / SESSION SECRET
# ----------------------------------------
# A long random string used to sign login sessions.
# If someone guesses this value they could forge a login, so keep it secret.
#
# CREATE ONE: run this command in the terminal and paste the result here:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# IMPORTANT: use a DIFFERENT value on your computer and on Vercel.
AUTH_SECRET="replace-this-with-a-long-random-string-at-least-32-characters"


# ----------------------------------------
# 3. FIRST ADMIN ACCOUNT (used only by "npm run admin:create" / "npm run db:seed")
# ----------------------------------------
# These values create your FIRST administrator account.
# After the account exists you may delete ADMIN_PASSWORD from this file
# and simply use the login page. Never put these values in code.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""


# ----------------------------------------
# 4. WEBSITE ADDRESS (used for SEO / sitemap / share links)
# ----------------------------------------
# Local development:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# On Vercel, set this to your real address, for example:
# NEXT_PUBLIC_SITE_URL="https://janakalyan-samataa-yuwa-club.vercel.app"


# ----------------------------------------
# 5. MEMBER REGISTRATION SWITCH
# ----------------------------------------
# MEMBERS CANNOT REGISTER THEMSELVES. Accounts are created by an administrator
# from:  Admin Panel -> Members -> Add member
#
# "false" = only administrators create member accounts (the shipped default)
# "true"  = would allow the old self-registration form - NOT recommended
#
# Turning this on is NOT enough on its own: the endpoint involved also requires
# ALLOW_MEMBER_SELF_REGISTRATION="true" (see below), and member records created
# that way would have no membership number, address or district.
MEMBER_REGISTRATION_ENABLED="false"

# The second half of the same safety switch. Leave as "false".
ALLOW_MEMBER_SELF_REGISTRATION="false"


# ----------------------------------------
# 6. IMAGE UPLOADS (optional)
# ----------------------------------------
# During local development uploaded files are saved into public/uploads.
# Vercel's file system is read-only, so in production you need an image host.
#
# EASIEST OPTION: Vercel Blob (https://vercel.com/storage/blob)
#   Create a Blob store in your Vercel project and paste its token here.
#   If this value is empty, the website will still work - you can simply
#   paste external image links into the Admin Panel instead of uploading.
BLOB_READ_WRITE_TOKEN=""


# ----------------------------------------
# 7. EMAIL (SMTP) - verification and password reset messages
# ----------------------------------------
# The website sends REAL emails: when an administrator creates a member, when a
# member forgets their password, and for important account events.
#
# UNTIL YOU FILL THIS IN
#   Everything still works, but no email goes out. The member's verification link
#   is printed in the SERVER TERMINAL (the window where you ran npm run dev), and
#   the Admin Panel says plainly that the email was not sent. Nothing is faked.
#
# WHERE TO GET THESE VALUES (Gmail example)
#   1. Turn on 2-Step Verification on the Google account.
#   2. Google Account -> Security -> App passwords -> create one for "Mail".
#   3. Use the 16 character password it shows you as SMTP_PASSWORD below.
#      (Your normal Gmail password will NOT work.)
#
# SMTP_HOST   -> smtp.gmail.com for Gmail. Also common:
#                smtp-mail.outlook.com, smtp.zoho.com, mail.yourdomain.com
# SMTP_PORT   -> 587 (STARTTLS, the usual choice) or 465 (SSL)
# SMTP_SECURE -> "false" for port 587, "true" for port 465
# SMTP_USER   -> the full email address the mail is sent from
# SMTP_PASSWORD -> the app password (never your normal password)
# MAIL_FROM   -> the address that appears as the sender.
#                On Gmail this must be the same as SMTP_USER.
MAIL_FROM_NAME="Janakalyan Samataa Yuwa Club"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Optional: where a member's reply should go (for example the office inbox).
MAIL_REPLY_TO=""
